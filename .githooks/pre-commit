#!/bin/sh
# Normalize staged notebooks before committing (outputs + volatile metadata).
if command -v python >/dev/null 2>&1; then
  python tools/strip_notebook_outputs.py || exit 1
elif command -v python3 >/dev/null 2>&1; then
  python3 tools/strip_notebook_outputs.py || exit 1
else
  echo "Python not found; skipping notebook output cleanup."
fi
